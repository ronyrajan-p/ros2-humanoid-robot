<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="leg" params="prefix side">
    <link name="${prefix}_hip_yaw_link"><inertial><mass value="0.3"/><xacro:sphere_inertia mass="0.3" radius="0.045"/></inertial><visual><geometry><sphere radius="0.045"/></geometry><material name="grey"/></visual><collision><geometry><sphere radius="0.045"/></geometry></collision></link>
    <joint name="${prefix}_hip_yaw" type="revolute"><parent link="pelvis"/><child link="${prefix}_hip_yaw_link"/><origin xyz="0 ${side * 0.09} -0.05"/><axis xyz="0 0 1"/><limit lower="-0.78" upper="0.78" effort="40" velocity="2"/><dynamics damping="0.3" friction="0.05"/></joint>
    <link name="${prefix}_hip_roll_link"><inertial><mass value="0.3"/><xacro:sphere_inertia mass="0.3" radius="0.045"/></inertial><visual><geometry><sphere radius="0.045"/></geometry><material name="grey"/></visual><collision><geometry><sphere radius="0.045"/></geometry></collision></link>
    <joint name="${prefix}_hip_roll" type="revolute"><parent link="${prefix}_hip_yaw_link"/><child link="${prefix}_hip_roll_link"/><axis xyz="1 0 0"/><limit lower="-0.5" upper="0.5" effort="40" velocity="2"/><dynamics damping="0.3" friction="0.05"/></joint>
    <link name="${prefix}_thigh"><inertial><origin xyz="0 0 ${-thigh_length/2}"/><mass value="2.0"/><xacro:cylinder_inertia mass="2.0" radius="0.05" length="${thigh_length}"/></inertial><visual><origin xyz="0 0 ${-thigh_length/2}"/><geometry><cylinder radius="0.05" length="${thigh_length}"/></geometry><material name="dark_grey"/></visual><collision><origin xyz="0 0 ${-thigh_length/2}"/><geometry><cylinder radius="0.05" length="${thigh_length}"/></geometry></collision></link>
    <joint name="${prefix}_hip_pitch" type="revolute"><parent link="${prefix}_hip_roll_link"/><child link="${prefix}_thigh"/><axis xyz="0 1 0"/><limit lower="-1.57" upper="1.0" effort="60" velocity="2.5"/><dynamics damping="0.4" friction="0.08"/></joint>
    <link name="${prefix}_shin"><inertial><origin xyz="0 0 ${-shin_length/2}"/><mass value="1.5"/><xacro:cylinder_inertia mass="1.5" radius="0.045" length="${shin_length}"/></inertial><visual><origin xyz="0 0 ${-shin_length/2}"/><geometry><cylinder radius="0.045" length="${shin_length}"/></geometry><material name="dark_grey"/></visual><collision><origin xyz="0 0 ${-shin_length/2}"/><geometry><cylinder radius="0.045" length="${shin_length}"/></geometry></collision></link>
    <joint name="${prefix}_knee" type="revolute"><parent link="${prefix}_thigh"/><child link="${prefix}_shin"/><origin xyz="0 0 ${-thigh_length}"/><axis xyz="0 1 0"/><limit lower="0" upper="2.35" effort="60" velocity="2.5"/><dynamics damping="0.4" friction="0.08"/></joint>
    <link name="${prefix}_foot"><inertial><origin xyz="0.03 0 -0.02"/><mass value="0.4"/><xacro:box_inertia mass="0.4" x="0.20" y="0.09" z="0.04"/></inertial><visual><origin xyz="0.03 0 -0.02"/><geometry><box size="0.20 0.09 0.04"/></geometry><material name="grey"/></visual><collision><origin xyz="0.03 0 -0.02"/><geometry><box size="0.20 0.09 0.04"/></geometry></collision></link>
    <joint name="${prefix}_ankle_pitch" type="revolute"><parent link="${prefix}_shin"/><child link="${prefix}_foot"/><origin xyz="0 0 ${-shin_length}"/><axis xyz="0 1 0"/><limit lower="-0.6" upper="0.6" effort="30" velocity="2.5"/><dynamics damping="0.25" friction="0.05"/></joint>
  </xacro:macro>
</robot>
