<?xml version="1.0"?>
<robot name="humanoid_robot">

  <!-- ============================================================= -->
  <!-- MATERIALS                                                      -->
  <!-- ============================================================= -->
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>
  <material name="skin">
    <color rgba="0.85 0.7 0.6 1.0"/>
  </material>

  <!-- ============================================================= -->
  <!-- MACRO-LIKE INERTIAL HELPERS (written out explicitly per link)  -->
  <!-- ============================================================= -->

  <!-- ============================================================= -->
  <!-- BASE / PELVIS                                                  -->
  <!-- ============================================================= -->
  <link name="base_link"/>

  <link name="pelvis">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.22 0.16 0.10"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.22 0.16 0.10"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_pelvis" type="fixed">
    <parent link="base_link"/>
    <child link="pelvis"/>
    <origin xyz="0 0 0.85" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================= -->
  <!-- TORSO (WAIST JOINT)                                            -->
  <!-- ============================================================= -->
  <link name="torso">
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.20 0.34"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.20 0.34"/>
      </geometry>
    </collision>
  </link>

  <joint name="waist_joint" type="revolute">
    <parent link="pelvis"/>
    <child link="torso"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.78" upper="0.78" effort="50" velocity="2.0"/>
  </joint>

  <!-- ============================================================= -->
  <!-- HEAD (NECK JOINT)                                              -->
  <!-- ============================================================= -->
  <link name="head">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.10"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.10"/>
      </geometry>
    </collision>
  </link>

  <joint name="neck_joint" type="revolute">
    <parent link="torso"/>
    <child link="head"/>
    <origin xyz="0 0 0.42" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.6" upper="0.6" effort="10" velocity="2.0"/>
  </joint>

  <!-- ============================================================= -->
  <!-- LEFT ARM: shoulder_pitch -> shoulder_roll -> elbow -> hand     -->
  <!-- ============================================================= -->
  <link name="left_shoulder_stub">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.04"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.04"/></geometry>
    </collision>
  </link>

  <joint name="left_shoulder_pitch" type="revolute">
    <parent link="torso"/>
    <child link="left_shoulder_stub"/>
    <origin xyz="0 0.18 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="1.57" effort="30" velocity="3.0"/>
  </joint>

  <link name="left_upper_arm">
    <inertial>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.20"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.20"/></geometry>
    </collision>
  </link>

  <joint name="left_shoulder_roll" type="revolute">
    <parent link="left_shoulder_stub"/>
    <child link="left_upper_arm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="30" velocity="3.0"/>
  </joint>

  <link name="left_forearm">
    <inertial>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.20"/></geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.20"/></geometry>
    </collision>
  </link>

  <joint name="left_elbow" type="revolute">
    <parent link="left_upper_arm"/>
    <child link="left_forearm"/>
    <origin xyz="0 0 -0.20" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="2.35" effort="20" velocity="3.0"/>
  </joint>

  <link name="left_hand">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <geometry><box size="0.06 0.04 0.10"/></geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <geometry><box size="0.06 0.04 0.10"/></geometry>
    </collision>
  </link>

  <joint name="left_wrist" type="fixed">
    <parent link="left_forearm"/>
    <child link="left_hand"/>
    <origin xyz="0 0 -0.25" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================= -->
  <!-- RIGHT ARM (mirror of left)                                     -->
  <!-- ============================================================= -->
  <link name="right_shoulder_stub">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.04"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.04"/></geometry>
    </collision>
  </link>

  <joint name="right_shoulder_pitch" type="revolute">
    <parent link="torso"/>
    <child link="right_shoulder_stub"/>
    <origin xyz="0 -0.18 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="1.57" effort="30" velocity="3.0"/>
  </joint>

  <link name="right_upper_arm">
    <inertial>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.20"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.20"/></geometry>
    </collision>
  </link>

  <joint name="right_shoulder_roll" type="revolute">
    <parent link="right_shoulder_stub"/>
    <child link="right_upper_arm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="30" velocity="3.0"/>
  </joint>

  <link name="right_forearm">
    <inertial>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.20"/></geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.20"/></geometry>
    </collision>
  </link>

  <joint name="right_elbow" type="revolute">
    <parent link="right_upper_arm"/>
    <child link="right_forearm"/>
    <origin xyz="0 0 -0.20" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="2.35" effort="20" velocity="3.0"/>
  </joint>

  <link name="right_hand">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <geometry><box size="0.06 0.04 0.10"/></geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <geometry><box size="0.06 0.04 0.10"/></geometry>
    </collision>
  </link>

  <joint name="right_wrist" type="fixed">
    <parent link="right_forearm"/>
    <child link="right_hand"/>
    <origin xyz="0 0 -0.25" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================= -->
  <!-- LEFT LEG: hip_yaw -> hip_roll -> hip_pitch -> knee -> ankle    -->
  <!-- ============================================================= -->
  <link name="left_hip_yaw_link">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0008"/>
    </inertial>
    <visual><geometry><sphere radius="0.045"/></geometry><material name="grey"/></visual>
    <collision><geometry><sphere radius="0.045"/></geometry></collision>
  </link>

  <joint name="left_hip_yaw" type="revolute">
    <parent link="pelvis"/>
    <child link="left_hip_yaw_link"/>
    <origin xyz="0 0.09 -0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.78" upper="0.78" effort="40" velocity="2.0"/>
  </joint>

  <link name="left_hip_roll_link">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0008"/>
    </inertial>
    <visual><geometry><sphere radius="0.045"/></geometry><material name="grey"/></visual>
    <collision><geometry><sphere radius="0.045"/></geometry></collision>
  </link>

  <joint name="left_hip_roll" type="revolute">
    <parent link="left_hip_yaw_link"/>
    <child link="left_hip_roll_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="40" velocity="2.0"/>
  </joint>

  <link name="left_thigh">
    <inertial>
      <origin xyz="0 0 -0.18" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.18" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.36"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.18" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.36"/></geometry>
    </collision>
  </link>

  <joint name="left_hip_pitch" type="revolute">
    <parent link="left_hip_roll_link"/>
    <child link="left_thigh"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.0" effort="60" velocity="2.5"/>
  </joint>

  <link name="left_shin">
    <inertial>
      <origin xyz="0 0 -0.18" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.18" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.36"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.18" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.36"/></geometry>
    </collision>
  </link>

  <joint name="left_knee" type="revolute">
    <parent link="left_thigh"/>
    <child link="left_shin"/>
    <origin xyz="0 0 -0.36" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.35" effort="60" velocity="2.5"/>
  </joint>

  <link name="left_foot">
    <inertial>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0.03 0 -0.02" rpy="0 0 0"/>
      <geometry><box size="0.20 0.09 0.04"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0.03 0 -0.02" rpy="0 0 0"/>
      <geometry><box size="0.20 0.09 0.04"/></geometry>
    </collision>
  </link>

  <joint name="left_ankle_pitch" type="revolute">
    <parent link="left_shin"/>
    <child link="left_foot"/>
    <origin xyz="0 0 -0.36" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.6" upper="0.6" effort="30" velocity="2.5"/>
  </joint>

  <!-- ============================================================= -->
  <!-- RIGHT LEG (mirror of left)                                     -->
  <!-- ============================================================= -->
  <link name="right_hip_yaw_link">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0008"/>
    </inertial>
    <visual><geometry><sphere radius="0.045"/></geometry><material name="grey"/></visual>
    <collision><geometry><sphere radius="0.045"/></geometry></collision>
  </link>

  <joint name="right_hip_yaw" type="revolute">
    <parent link="pelvis"/>
    <child link="right_hip_yaw_link"/>
    <origin xyz="0 -0.09 -0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.78" upper="0.78" effort="40" velocity="2.0"/>
  </joint>

  <link name="right_hip_roll_link">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0008"/>
    </inertial>
    <visual><geometry><sphere radius="0.045"/></geometry><material name="grey"/></visual>
    <collision><geometry><sphere radius="0.045"/></geometry></collision>
  </link>

  <joint name="right_hip_roll" type="revolute">
    <parent link="right_hip_yaw_link"/>
    <child link="right_hip_roll_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="40" velocity="2.0"/>
  </joint>

  <link name="right_thigh">
    <inertial>
      <origin xyz="0 0 -0.18" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.18" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.36"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.18" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.36"/></geometry>
    </collision>
  </link>

  <joint name="right_hip_pitch" type="revolute">
    <parent link="right_hip_roll_link"/>
    <child link="right_thigh"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.0" effort="60" velocity="2.5"/>
  </joint>

  <link name="right_shin">
    <inertial>
      <origin xyz="0 0 -0.18" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.18" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.36"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.18" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.36"/></geometry>
    </collision>
  </link>

  <joint name="right_knee" type="revolute">
    <parent link="right_thigh"/>
    <child link="right_shin"/>
    <origin xyz="0 0 -0.36" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.35" effort="60" velocity="2.5"/>
  </joint>

  <link name="right_foot">
    <inertial>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0.03 0 -0.02" rpy="0 0 0"/>
      <geometry><box size="0.20 0.09 0.04"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0.03 0 -0.02" rpy="0 0 0"/>
      <geometry><box size="0.20 0.09 0.04"/></geometry>
    </collision>
  </link>

  <joint name="right_ankle_pitch" type="revolute">
    <parent link="right_shin"/>
    <child link="right_foot"/>
    <origin xyz="0 0 -0.36" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.6" upper="0.6" effort="30" velocity="2.5"/>
  </joint>

</robot>
