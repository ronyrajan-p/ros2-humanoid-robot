<?xml version="1.0"?>
<robot name="humanoid_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="controllers_file" default="config/controllers.yaml"/>
  <xacro:include filename="properties.xacro"/>
  <xacro:include filename="arm.xacro"/>
  <xacro:include filename="leg.xacro"/>

  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="dark_grey"><color rgba="0.25 0.25 0.25 1"/></material>
  <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
  <material name="skin"><color rgba="0.85 0.7 0.6 1"/></material>

  <link name="base_link"/>
  <link name="pelvis"><inertial><mass value="3.0"/><xacro:box_inertia mass="3.0" x="0.22" y="0.16" z="0.10"/></inertial><visual><geometry><box size="0.22 0.16 0.10"/></geometry><material name="dark_grey"/></visual><collision><geometry><box size="0.22 0.16 0.10"/></geometry></collision></link>
  <joint name="base_to_pelvis" type="fixed"><parent link="base_link"/><child link="pelvis"/><origin xyz="0 0 0.85"/></joint>

  <link name="torso"><inertial><origin xyz="0 0 0.15"/><mass value="8.0"/><xacro:box_inertia mass="8.0" x="0.28" y="0.20" z="0.34"/></inertial><visual><origin xyz="0 0 0.15"/><geometry><box size="0.28 0.20 0.34"/></geometry><material name="blue"/></visual><collision><origin xyz="0 0 0.15"/><geometry><box size="0.28 0.20 0.34"/></geometry></collision></link>
  <joint name="waist_joint" type="revolute"><parent link="pelvis"/><child link="torso"/><origin xyz="0 0 0.05"/><axis xyz="0 0 1"/><limit lower="-0.78" upper="0.78" effort="50" velocity="2"/><dynamics damping="0.5" friction="0.1"/></joint>

  <link name="head"><inertial><mass value="1.2"/><xacro:sphere_inertia mass="1.2" radius="0.10"/></inertial><visual><geometry><sphere radius="0.10"/></geometry><material name="skin"/></visual><collision><geometry><sphere radius="0.10"/></geometry></collision></link>
  <joint name="neck_joint" type="revolute"><parent link="torso"/><child link="head"/><origin xyz="0 0 0.42"/><axis xyz="0 1 0"/><limit lower="-0.6" upper="0.6" effort="10" velocity="2"/><dynamics damping="0.1" friction="0.02"/></joint>

  <xacro:arm prefix="left" side="1"/>
  <xacro:arm prefix="right" side="-1"/>
  <xacro:leg prefix="left" side="1"/>
  <xacro:leg prefix="right" side="-1"/>

  <!-- Gazebo exposes all actuated URDF joints through position interfaces. -->
  <ros2_control name="HumanoidGazeboSystem" type="system">
    <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
    <xacro:macro name="position_joint" params="name"><joint name="${name}"><command_interface name="position"><param name="min">-3.14</param><param name="max">3.14</param></command_interface><state_interface name="position"/><state_interface name="velocity"/></joint></xacro:macro>
    <xacro:position_joint name="waist_joint"/><xacro:position_joint name="neck_joint"/>
    <xacro:position_joint name="left_shoulder_pitch"/><xacro:position_joint name="left_shoulder_roll"/><xacro:position_joint name="left_elbow"/>
    <xacro:position_joint name="right_shoulder_pitch"/><xacro:position_joint name="right_shoulder_roll"/><xacro:position_joint name="right_elbow"/>
    <xacro:position_joint name="left_hip_yaw"/><xacro:position_joint name="left_hip_roll"/><xacro:position_joint name="left_hip_pitch"/><xacro:position_joint name="left_knee"/><xacro:position_joint name="left_ankle_pitch"/>
    <xacro:position_joint name="right_hip_yaw"/><xacro:position_joint name="right_hip_roll"/><xacro:position_joint name="right_hip_pitch"/><xacro:position_joint name="right_knee"/><xacro:position_joint name="right_ankle_pitch"/>
  </ros2_control>
  <gazebo><plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so"><parameters>$(arg controllers_file)</parameters></plugin></gazebo>

  <gazebo reference="head"><sensor name="head_camera" type="camera"><always_on>true</always_on><update_rate>20</update_rate><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.05</near><far>15</far></clip></camera><plugin name="head_camera_ros" filename="libgazebo_ros_camera.so"><camera_name>head_camera</camera_name><frame_name>head</frame_name></plugin></sensor></gazebo>
  <gazebo reference="torso"><sensor name="torso_imu" type="imu"><always_on>true</always_on><update_rate>100</update_rate><plugin name="torso_imu_ros" filename="libgazebo_ros_imu_sensor.so"><topic_name>imu/data</topic_name><frame_name>torso</frame_name></plugin></sensor></gazebo>
  <gazebo reference="torso"><sensor name="torso_lidar" type="ray"><always_on>true</always_on><update_rate>10</update_rate><ray><scan><horizontal><samples>360</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>12.0</max><resolution>0.02</resolution></range></ray><plugin name="torso_lidar_ros" filename="libgazebo_ros_ray_sensor.so"><topic_name>scan</topic_name><frame_name>torso</frame_name></plugin></sensor></gazebo>
</robot>
